NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel AI Gateway
AI_GATEWAY_API_KEY=replace_with_vercel_ai_gateway_key
VERCEL_AI_GATEWAY_API_KEY=replace_with_vercel_ai_gateway_key
AI_GATEWAY_MODEL=amazon/nova-micro

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=c243kj7a
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_WRITE_TOKEN=optional_write_token_for_form_submissions_and_subscribers
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333

# Resend update emails
RESEND_API_KEY=replace_with_resend_api_key
UPDATES_FROM_EMAIL="SKYPA Foundation <updates@skypafoundation.org>"
UPDATES_WEBHOOK_SECRET=choose_a_long_random_secret

# Upstash CMS backend
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace_with_upstash_rest_token

# Secure admin dashboard
# Generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET=replace_with_a_long_random_session_secret
# Generate with: openssl rand -base64 32
ADMIN_BOOTSTRAP_TOKEN=replace_with_a_private_first_admin_setup_token
# Optional comma-separated allowlist. If set, only these emails can create/sign in as admin.
ADMIN_ALLOWED_EMAILS=admin@example.com
